// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  
  id                Int       @id @default(autoincrement())
  number            String    @unique
  password          String
  
  // Basic Identity
  name              String?
  email             String?   @unique
  profilePicture    String?  
  
  // Demographics & KYC
  dob               DateTime?
  gender            String?
  address           String?
  panNumber         String?   @unique 
  
  // Security & Linking
  transactionPin    String?   
  upiId             String?   @unique
  
  // State Flag
  isProfileComplete Boolean   @default(false)

  //deleted status
  deletedAt   DateTime?

  // Relations
  OnRampTransaction   OnRampTransaction[]
  OffRampTransaction  OffRampTransaction[]
  Balance             Balance[]
  sentTransfers       p2pTransfer[]       @relation(name: "FromUserRelation")
  receivedTransfers   p2pTransfer[]       @relation(name: "ToUserRelation")
  sentMessages        p2pMessage[]        @relation(name: "MessageFromUser")
  receivedMessages    p2pMessage[]        @relation(name: "MessageToUser")
  notifications       Notification[]
  ledgerEntries       LedgerEntry[]

  //Merchant Relationship
  sentTransfersMerchant   MerchantTransfer[]  

}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  type      String   // "TRANSFER", "MESSAGE", "SYSTEM"
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  //deleted status
  deletedAt   DateTime?

  @@index([userId])
}

model Merchant {
  id        Int     @id @default(autoincrement())
  email     String  @unique
  name      String?
  auth_type AuthType
  password  String? 
  merchantCode String @unique
  balance   Int     @default(0)
  transfers MerchantTransfer[]
  ledgerEntries LedgerEntry[]
  //deleted status
  deletedAt   DateTime?
  
}
model MerchantTransfer {
  id        Int     @id @default(autoincrement())
  amount    Int
  timestamp DateTime @default(now())
  fromUserId Int
  toMerchantId Int
  fromUser User @relation(fields: [fromUserId], references: [id])
  toMerchant Merchant @relation(fields: [toMerchantId], references: [id])

  @@index([fromUserId])
  @@index([toMerchantId])
}


model OnRampTransaction {
  id        Int          @id @default(autoincrement())
  status    RampStatus
  token     String       @unique
  provider  String
  amount    Int
  startTime DateTime
  userId    Int
  user      User         @relation(fields: [userId], references: [id])

  @@index([userId])
}

model OffRampTransaction {
  id        Int          @id @default(autoincrement())
  status    RampStatus
  token     String       @unique
  amount    Int
  startTime DateTime
  userId    Int
  user      User         @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Balance {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  amount Int
  locked Int
  user   User @relation(fields: [userId], references: [id])
}

model OTP {
  id        Int      @id @default(autoincrement())
  phone     String   @unique
  code      String
  expiresAt DateTime
}


enum RampStatus {
  Success
  Failure
  Processing
}

enum AuthType {
  Google
  Github
  Email
}

model p2pTransfer {
  id         Int          @id @default(autoincrement())
  amount     Int
  timestamp  DateTime     @default(now())
  fromUserId Int
  fromUser   User         @relation(name: "FromUserRelation", fields: [fromUserId], references: [id])
  toUserId   Int
  toUser     User         @relation(name: "ToUserRelation", fields: [toUserId], references: [id])
  message    p2pMessage?

  @@index([fromUserId])
  @@index([toUserId])
}

model p2pMessage {
  id         Int          @id @default(autoincrement())
  content    String?
  timestamp  DateTime     @default(now())
  fromUserId Int
  fromUser   User         @relation(name: "MessageFromUser", fields: [fromUserId], references: [id])
  toUserId   Int
  toUser     User         @relation(name: "MessageToUser", fields: [toUserId], references: [id])
  transferId Int?         @unique
  transfer   p2pTransfer? @relation(fields: [transferId], references: [id])
  //deleted status
  deletedAt   DateTime?

  @@index([fromUserId])
  @@index([toUserId])
}

enum TxType {
  ONRAMP
  OFFRAMP
  P2P_TRANSFER
  MERCHANT_PAYMENT
}

model LedgerEntry {
  id          Int       @id @default(autoincrement())
  userId      Int?
  merchantId  Int?
  amount      Int       // Negative for debit, positive for credit
  type        TxType
  referenceId String?   // Transaction token or stringified ID
  timestamp   DateTime  @default(now())
  
  user        User?     @relation(fields: [userId], references: [id])
  merchant    Merchant? @relation(fields: [merchantId], references: [id])
  
  @@index([userId])
  @@index([merchantId])
}
