    "turbo": "^2.9.16"
  },
  "dependencies": {
    "lucide-react": "^1.32.0",
    "next-themes": "^0.4.6",
    "razorpay": "^2.9.6"
  },
  "optionalDependencies": {
    "@next/swc-win32-x64-msvc": "^16.2.7"
  }
